@using ClusterManagement.Client.DataflowEvents.Models
@using ClusterManagement.Public
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Enums
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@inherits ModulePageBase<ClusterManagementClientModule>
@attribute [Route(Constants.ManagementEventsRoute)]

<div class="cluster-events">
    <div class="cluster-events-toolbar">
        <Toolbar>
            <ToolbarGroup>
                <ToolbarContent Enabled="false">
                    @($"Cluster {PageService.ActiveVersion}")
                </ToolbarContent>
            </ToolbarGroup>

            <ToolbarGroup AlignRight="true">
                <ToolbarContent Enabled="false">
                    @($"{CommonVocabulary.Selected}: {@PageService.SelectedEvent?.Name}")
                </ToolbarContent>
                <ToolbarContent>
                    <span class="events-input-value">@CommonVocabulary.Value</span>
                    <TextBox Enabled="true" @bind-Value="@PageService.SendInputValue"></TextBox>
                </ToolbarContent>
                <ToolbarButton Text="@(string.Format(UserActions.SetSomething, CommonVocabulary.Value))"
                               Tooltip="@(string.Format(UserActions.SetSomething, CommonVocabulary.Value))"
                               OnClick="@PageService.SetSelectedValue"
                               IconName="@MonochromeIconName.SendLight"
                               TextVisibility="@TextVisibility.MenuOnly" />
            </ToolbarGroup>

            <ToolbarGroup AlignRight="true">
                <ToolbarButton IconName="@MonochromeIconName.DataflowLight"
                               Text="@CommonVocabulary.Management"
                               OnClick="@NavigateToManagement" />

                <ToolbarButton IconName="@MonochromeIconName.Refresh"
                               Text="@CommonVocabulary.RefreshVerb"
                               Tooltip="@CommonVocabulary.RefreshVerb"
                               OnClick="@RefreshDataflowEvents" />

                <ToolbarButton IconName="@MonochromeIconName.PlusSlim"
                               Text="@(string.Format(UserActions.SubscribeSomething, CommonVocabulary.All))"
                               OnClick="@PageService.SubscribeAll" />

                <ToolbarButton IconName="@MonochromeIconName.MinusSlim"
                               Text="@(string.Format(UserActions.UnsubscribeSomething, CommonVocabulary.All))"
                               OnClick="@PageService.UnsubscribeAll" />
            </ToolbarGroup>
        </Toolbar>
    </div>

    <div class="cluster-events-grid">
        <SimpleTable TItem="DataflowEventModel"
                     Items="@PageService.Events"
                     SelectionMode="SelectionMode.Single"
                     RowClickSelectionEnabled="true"
                     Mode="TableLoadingMode.Virtualize"
                     MaximumHeight="100%"
                     SelectedItems="@_selectedEvents"
                     SelectedItemsChanged="@SelectedEventChanged">
            <Columns>
                <SimpleTableTemplateColumn Id="EventId" Title="@nameof(DataflowEventModel.EventId)" Resizeable="false">
                    <CellContent>
                        @context.EventId
                    </CellContent>
                </SimpleTableTemplateColumn>
                <SimpleTableTemplateColumn Id="Name" Title="@CommonVocabulary.Name" Resizeable="false">
                    <CellContent>@context.Name</CellContent>
                </SimpleTableTemplateColumn>
                <SimpleTableTemplateColumn Id="ValueType" Title="@TechnicalTerms.ValueType" Resizeable="false">
                    <CellContent>@context.ValueType</CellContent>
                </SimpleTableTemplateColumn>
                <SimpleTableTemplateColumn Id="Writable" Title="@Localization.DataflowEventsPage.Writable" Resizeable="false">
                    <CellContent>@context.CanWrite</CellContent>
                </SimpleTableTemplateColumn>
                <SimpleTableTemplateColumn Id="Readable" Title="@Localization.DataflowEventsPage.Readable" Resizeable="false">
                    <CellContent>@context.CanRead</CellContent>
                </SimpleTableTemplateColumn>
                <SimpleTableTemplateColumn Id="Value" Title="@CommonVocabulary.Value" Resizeable="false">
                    <CellContent>@context.DisplayValue</CellContent>
                </SimpleTableTemplateColumn>
                <SimpleTableTemplateColumn Id="Timestamp" Title="@TechnicalTerms.Timestamp" Resizeable="false">
                    <CellContent>@context.Timestamp?.ToString("s")</CellContent>
                </SimpleTableTemplateColumn>
                <SimpleTableTemplateColumn Id="Actions" Title="@CommonVocabulary.ActionPlural" Resizeable="false" Width="150">
                    <CellContent>
                        <div class="action-column">
                            @if (context.Subscription is null)
                            {
                                <Button IconCssClass="@_plusIconCssClass"
                                        OnClick="@(() => PageService.SubscribeEvent(context))"
                                        Title="@CommonVocabulary.Subscribe"
                                        Size="@ButtonSize.Small" />
                            }
                            else
                            {
                                <Button IconCssClass="@_minusIconCssClass"
                                        OnClick="@(() => PageService.UnsubscribeEvent(context))"
                                        Title="@CommonVocabulary.Unsubscribe"
                                        Size="@ButtonSize.Small" />
                            }
                        </div>
                    </CellContent>
                </SimpleTableTemplateColumn>
            </Columns>
        </SimpleTable>
    </div>
</div>
