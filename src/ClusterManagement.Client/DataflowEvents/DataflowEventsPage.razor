@using ClusterManagement.Client.DataflowEvents.Models
@using ClusterManagement.Public
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Blazor.Components.TextBox
@using ViciOne.Ui.Localization.Resources

@inherits ModulePageBase<ClusterManagementClientModule>
@attribute [Route(Constants.ManagementEventsRoute)]

<div class="cluster-events">
    <section class="events-head">
        <a class="back-link" href="@Constants.ManagementModuleRoute">← @CommonVocabulary.Management</a>

        <div class="title-row">
            <div class="title">
                <h1>@Localization.DataflowEventsPage.PageTitle</h1>
                @if (PageService.ActiveVersion is { } activeVersion)
                {
                    <div class="muted">@string.Format(Localization.DataflowEventsPage.DataflowEventsOfVersion, activeVersion)</div>
                }
            </div>

            <div class="actions">
                <SearchBox CssClass="filter"
                           Text="@_filter"
                           TextChanging="@ApplyFilter"
                           Placeholder="@Localization.DataflowEventsPage.FilterByName" />
                <span class="muted shown">@string.Format(Localization.DataflowEventsPage.EventsShown, ShownCount, PageService.Events.Count)</span>
                @if (_grouping != DataflowEventGrouping.None)
                {
                    <Button Text="@ToggleExpansionText"
                            OnClick="@ToggleExpansion" />
                }
                <Button Text="@ToggleSubscriptionsText"
                        OnClick="@ToggleSubscriptions" />
                <Button IconCssClass="@_refreshIconCssClass"
                        Title="@CommonVocabulary.RefreshVerb"
                        OnClick="@RefreshDataflowEvents" />
            </div>
        </div>

        <div class="chips">
            <span class="muted">@Localization.DataflowEventsPage.GroupBy</span>
            @foreach (var (grouping, label) in Groupings)
            {
                <Button Text="@label"
                        CssClass="@ChipCssClass(grouping == _grouping)"
                        Size="@ButtonSize.Small"
                        OnClick="@(() => SetGrouping(grouping))" />
            }

            <span class="muted gap">@Localization.DataflowEventsPage.Show</span>
            @foreach (var (direction, label) in Directions)
            {
                <Button Text="@label"
                        CssClass="@ChipCssClass(direction == _direction)"
                        Size="@ButtonSize.Small"
                        OnClick="@(() => SetDirection(direction))" />
            }

            <span class="spacer"></span>
            <span class="legend muted">@s_legendInputIcon @Localization.DataflowEventsPage.InputLegend</span>
            <span class="legend muted">@s_legendOutputIcon @Localization.DataflowEventsPage.OutputLegend</span>
        </div>
    </section>

    <section class="events-table">
        <table>
            <colgroup>
                <col class="connector-column" />
                <col class="location-column" />
                <col class="type-column" />
                <col class="value-column" />
                <col class="time-column" />
                <col class="subscribe-column" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">@Localization.DataflowEventsPage.Connector</th>
                    <th scope="col" class="location">@Localization.DataflowEventsPage.Location</th>
                    <th scope="col">@TechnicalTerms.ValueType</th>
                    <th scope="col">@CommonVocabulary.Value</th>
                    <th scope="col">@TechnicalTerms.Timestamp</th>
                    <th scope="col">@Localization.DataflowEventsPage.Subscribed</th>
                </tr>
            </thead>
            <tbody>
                @* ItemSize is the row height the stylesheet gives every cell. Twenty rows on either side stay rendered, so a
                   server round trip while scrolling does not show as an empty area. *@
                <Virtualize Items="@_rows" Context="row" SpacerElement="tr" ItemSize="36" OverscanCount="20">
                    @if (row.Event is not { } dataflowEvent)
                    {
                        var isExpanded = IsExpanded(row.Group);
                        <tr class="group" @key="row.Group.Key">
                            <td colspan="6">
                                <div class="group-row">
                                    <Button Text="@GroupLabel(row.Group)"
                                            Title="@GroupLabel(row.Group)"
                                            IconCssClass="@(isExpanded ? _collapseIconCssClass : _expandIconCssClass)"
                                            CssClass="group-toggle"
                                            Size="@ButtonSize.Small"
                                            OnClick="@(() => ToggleGroup(row.Group))" />
                                    <span class="muted group-counts">@string.Format(Localization.DataflowEventsPage.GroupCounts, row.Group.InputCount, row.Group.OutputCount)</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="event @(_grouping == DataflowEventGrouping.None ? null : "nested")" @key="dataflowEvent.EventId">
                            <td>
                                <span class="connector">
                                    <span class="connector-icon" role="img" title="@DirectionTitle(dataflowEvent)" aria-label="@DirectionTitle(dataflowEvent)">@ConnectorIcon(dataflowEvent)</span>
                                    <span class="connector-name" title="@dataflowEvent.Name">@dataflowEvent.FunctionBlockName.<b>@dataflowEvent.ConnectorName</b></span>
                                </span>
                            </td>
                            <td class="muted location" title="@dataflowEvent.Location">@dataflowEvent.Location</td>
                            <td class="muted" title="@dataflowEvent.ValueType">@ValueTypeNames.Short(dataflowEvent.ValueType)</td>
                            <td>
                                @if (dataflowEvent.CanWrite)
                                {
                                    <div class="write">
                                        @if (IsBoolean(dataflowEvent))
                                        {
                                            <label class="write-check" title="@string.Format(Localization.DataflowEventsPage.WriteValue, dataflowEvent.Name)">
                                                <CheckBox @key="@CheckBoxKey(dataflowEvent)"
                                                          Value="@(dataflowEvent.PendingValue == bool.TrueString)"
                                                          ValueChanged="@((bool value) => WriteBoolean(dataflowEvent, value))" />
                                                <span class="hidden-label">@string.Format(Localization.DataflowEventsPage.ValueFor, dataflowEvent.Name)</span>
                                            </label>
                                        }
                                        else
                                        {
                                            <label class="hidden-label" for="@ValueInputId(dataflowEvent)">@string.Format(Localization.DataflowEventsPage.ValueFor, dataflowEvent.Name)</label>
                                            <TextBox Id="@ValueInputId(dataflowEvent)"
                                                     CssClass="value-input"
                                                     Placeholder="@Localization.DataflowEventsPage.ValueEnterWrites"
                                                     Value="@dataflowEvent.PendingValue"
                                                     ValueChanging="@(value => dataflowEvent.PendingValue = value)"
                                                     EnterPressed="@(() => WritePending(dataflowEvent))" />
                                            <Button IconCssClass="@_sendIconCssClass"
                                                    Title="@string.Format(Localization.DataflowEventsPage.WriteValue, dataflowEvent.Name)"
                                                    Size="@ButtonSize.Small"
                                                    Enabled="@(!string.IsNullOrEmpty(dataflowEvent.PendingValue))"
                                                    OnClick="@(() => WritePending(dataflowEvent))" />
                                        }
                                    </div>
                                }
                                else if (dataflowEvent.DisplayValue is { } value)
                                {
                                    <div class="copy-cell">
                                        <Button Text="@value"
                                                IconCssClass="@_copyIconCssClass"
                                                CssClass="copy"
                                                Title="@CommonVocabulary.CopyVerb"
                                                Size="@ButtonSize.Small"
                                                OnClick="@(() => CopyValue(dataflowEvent))" />
                                        @if (_copiedEventId == dataflowEvent.EventId)
                                        {
                                            <span class="copied">@Localization.DataflowEventsPage.Copied</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="muted time" title="@TimeTitle(dataflowEvent.Timestamp)">@TimeText(dataflowEvent.Timestamp)</td>
                            <td>
                                @if (dataflowEvent.CanRead)
                                {
                                    @if (dataflowEvent.Subscription is null)
                                    {
                                        <Button IconCssClass="@_plusIconCssClass"
                                                OnClick="@(() => PageService.SubscribeEvent(dataflowEvent))"
                                                Title="@CommonVocabulary.Subscribe"
                                                Size="@ButtonSize.Small" />
                                    }
                                    else
                                    {
                                        <Button IconCssClass="@_minusIconCssClass"
                                                OnClick="@(() => PageService.UnsubscribeEvent(dataflowEvent))"
                                                Title="@CommonVocabulary.Unsubscribe"
                                                Size="@ButtonSize.Small" />
                                    }
                                }
                            </td>
                        </tr>
                    }
                </Virtualize>
                @if (_groups.Count == 0)
                {
                    <tr class="empty">
                        <td colspan="6">@(PageService.Events.Count == 0 ? Localization.DataflowEventsPage.NoEvents : Localization.DataflowEventsPage.NoMatchingEvents)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</div>
