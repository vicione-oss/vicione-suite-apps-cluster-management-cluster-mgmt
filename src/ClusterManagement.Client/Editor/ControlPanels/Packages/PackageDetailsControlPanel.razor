@using ClusterManagement.Client.Editor.ControlPanels.Packages.Services
@using ClusterManagement.Client.Editor.Enums
@using ClusterManagement.Client.Editor.Extensions
@using ClusterManagement.Client.Extensions
@using ClusterManagement.Client.Localization
@using ClusterManagement.Internal.Contracts
@using Microsoft.AspNetCore.Components.Authorization
@using Sdk.Client.Components.Settings
@using Sdk.Client.ControlPanels.Components
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@inherits ControlPanelBase<PackageDetailsControlPanelState>

<ControlPanelPage Title="@CommonVocabulary.DetailPlural">
    <div class="package-detail-control-panel-page">
        <DescriptionBanner Title="@($"{CommonVocabulary.DetailPlural} {State.PackageInfo!.Name}")">
            @Localization.PackageDetailsControlPanel.BannerDescription
        </DescriptionBanner>

        <SettingsLayout>
            <SettingsGroup Title="@Localization.PackageDetailsControlPanel.PackageDetails" Expanded="true">
                <SettingsField Label="@CommonVocabulary.Name">
                    @State.PackageInfo.Name
                </SettingsField>

                <SettingsField Label="@CommonVocabulary.Description">
                    @State.PackageInfo.Description
                </SettingsField>
                
                @if (!string.IsNullOrEmpty(State.PackageInfo.RunningClusterVersion))
                {
                    <SettingsField Label="@Localization.PackageDetailsControlPanel.RunningClusterVersion">
                        <div class="active-cluster-version-wrapper">
                            @State.PackageInfo.RunningClusterVersion

                            <div title="@Editor.Localization.Common.ActiveInCluster" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.LockActive" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        </div>
                    </SettingsField>
                }

                <SettingsField Label="@LibraryManagement.InstalledVersion">
                    <div class="installed-version-wrapper">
                        @State.PackageInfo.InstalledVersion
                    
                        @if (State.PackageInfo.PendingOperation?.OperationKind is ClusterDependencyOperationKind.Uninstall)
                        {
                            <div title="@LibraryManagement.PendingUninstallation" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.UninstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }
                        else if (State.PackageInfo.Error is not null)
                        {
                            <div title="@State.PackageInfo.Error.Message" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.ErrorFull" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }
                    </div>
                </SettingsField>

                @if (string.IsNullOrEmpty(State.PackageInfo.RunningClusterVersion) &&
                    ((State.PackageInfo.Versions ?? []).Count > 1 ||
                    (string.IsNullOrEmpty(State.PackageInfo.InstalledVersion) && State.PackageInfo.PendingOperation?.OperationKind is not ClusterDependencyOperationKind.Install) ||
                    State.PackageInfo.PendingOperation?.OperationKind is ClusterDependencyOperationKind.Uninstall))
                {
                    <SettingsField Label="@UserActions.InstallVersion">
                        <div class="install-version-wrapper">
                            <AuthorizeView Policy="@AdminPolicy">
                                <div class="combo-box-wrapper">
                                    <SettingsFieldComboBox Items="@State.PackageInfo.Versions"
                                                           ValueSelector="@(item => item.Version)"
                                                           TextSelector="@(item => item.Version)"
                                                           @bind-Value="@State.VersionToInstall"
                                                           @bind-Value:after="(async () => await BeginEdit())" />

                                    @if (State.PackageInfo.AvailableUpdateVersion is not null)
                                    {
                                        <div title="@string.Format(LibraryManagement.UpdateToSpecificVersionAvailable, State.PackageInfo.AvailableUpdateVersion)" class="icon-wrapper">
                                            <MonochromeIcon Name="MonochromeIconName.UpdateAvailableLight" Size="MonochromeIconSize.SmallMedium" />
                                        </div>
                                    }
                                </div>
                            </AuthorizeView>

                            <div class="version">
                                @State.PackageInfo.InstalledVersion
                            </div>
                        </div>
                    </SettingsField>
                }

                @if (State.PackageInfo.PendingOperation is not null)
                {
                    if (State.PackageInfo.PendingOperation.OperationKind is ClusterDependencyOperationKind.Install)
                    {
                        var infoText = State.PackageInfo.InstalledVersion is null ?
                            string.Format(LibraryManagement.PendingInstallationOfSpecificVersion, State.PackageInfo.PendingOperation.Dependency.Version.ToString()) :
                            string.Format(LibraryManagement.PendingUpdateToSpecificVersion, State.PackageInfo.PendingOperation.Dependency.Version.ToString());

                        <SettingsInformation>
                            @infoText
                        </SettingsInformation>
                    }
                }
            </SettingsGroup>
        </SettingsLayout>
    </div>
</ControlPanelPage>
