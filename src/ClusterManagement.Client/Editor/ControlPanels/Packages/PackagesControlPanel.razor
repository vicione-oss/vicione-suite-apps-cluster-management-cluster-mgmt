@using ClusterManagement.Client.Editor.ControlPanels.Packages.Services
@using ClusterManagement.Client.Editor.Enums
@using ClusterManagement.Client.Editor.Extensions
@using ClusterManagement.Client.Extensions
@using ClusterManagement.Client.Localization
@using ClusterManagement.Internal.Contracts
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Sdk.Client.Components.Settings
@using Sdk.Client.ControlPanels.Components
@using Sdk.Client.ControlPanels.Services
@using ViciOne.Ui.Blazor.Components.Grid.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components.ActionButtons
@using ViciOne.Ui.Blazor.Components.Grid.Components.Columns
@using ViciOne.Ui.Blazor.Components.Grid.Components.Footers
@using ViciOne.Ui.Blazor.Components.Grid.Components.Panes
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using ViciOne.Ui.MonochromeIcons.Core.Extensions
@using ViciOne.Ui.Shared.Dx.Components

@inherits ControlPanelBase<PackagesControlPanelState>

<ControlPanelPage Title="@CommonVocabulary.Installed">
    <div class="packages-control-panel-page">
        <DescriptionBanner Title="@Localization.PackagesControlPanel.InstalledBannerTitle">
            @(string.Format(Localization.PackagesControlPanel.InstalledBannerDescription, PackageService.MinCoreVersion))
        </DescriptionBanner>

        <Grid Items="@FilterInstalledItems(State.InstalledQueryable)" Virtualize="true" CssClass="packages-grid">
            <ActionButtons>
                <div style="display:contents;">
                    <AuthorizeView Policy="@AdminPolicy">

                        <GridActionButton Text="@CommonVocabulary.UninstallVerb"
                                          OnClick="@UninstallPackagesClick"
                                          IconCssClass="@_uninstallIconCssClasses"
                                          Enabled="@CanUninstallPackages()" />

                        <GridActionButton Text="@CommonVocabulary.ResetVerb"
                                          OnClick="@(async () => await ResetInstalledSelectedModules())"
                                          IconCssClass="@_uninstallIconCssClasses"
                                          Enabled="@CanResetInstalledSelectedModules()" />
                    </AuthorizeView>
                </div>
            </ActionButtons>

            <Filter>
                <GridFilterControl @bind-Text="@State.InstalledFilterText" @bind-Text:after="@(() => InvokeAsync(StateHasChanged))" />
            </Filter>

            <ChildContent>
                <ItemSelectColumn KeySelector="@(item => item)"
                                  Selection="@InstalledItemSelection" />

                <TemplateColumn Title="@CommonVocabulary.Name">
                    @{
                        var key = new MarkupString(context.Name);

                        if (!string.IsNullOrEmpty(State.InstalledFilterText))
                            key = key.WithHighlightedText(State.InstalledFilterText);

                        @key
                    }
                </TemplateColumn>

                <TemplateColumn Title="@LibraryManagement.InstalledVersion">
                    <div class="version-wrapper">
                        <div class="version" title="@context.InstalledVersion">
                            @context.InstalledVersion
                        </div>
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="@CommonVocabulary.Status">
                    <div class="status-wrapper">
                        @if (context.PendingOperation is not null)
                        {
                            @if (context.PendingOperation.OperationKind is ClusterDependencyOperationKind.Install)
                            {
                                var tooltipText = context.InstalledVersion is null ?
                                    string.Format(LibraryManagement.PendingInstallationOfSpecificVersion, context.PendingOperation.Dependency.Version.ToString()) :
                                    string.Format(LibraryManagement.PendingUpdateToSpecificVersion, context.PendingOperation.Dependency.Version.ToString());

                                <div title="@tooltipText" class="icon-wrapper">
                                    <MonochromeIcon Name="MonochromeIconName.InstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                                </div>
                            }
                            else
                            {
                                <div title="@LibraryManagement.PendingUninstallation" class="icon-wrapper">
                                    <MonochromeIcon Name="MonochromeIconName.UninstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                                </div>
                            }
                        }

                        @if (context.AvailableUpdateVersion is not null)
                        {
                            <div title="@string.Format(LibraryManagement.UpdateToSpecificVersionAvailable, context.AvailableUpdateVersion)" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.UpdateAvailableLight" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(context.RunningClusterVersion))
                        {
                            <div title="@Editor.Localization.Common.ActiveInCluster" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.LockActive" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }

                        @if (context.Error is not null)
                        {
                            <div title="@context.Error.Message" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.ErrorFull" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }
                    </div>
                </TemplateColumn>

                <NavigationColumn NavigationButtonTitle="@Common.ShowDetails"
                                  Navigate="@((ClusterPackageInfo item) => ShowDetailsAsync(item))" />
            </ChildContent>

            <Footer>
                <SelectionFooter GridSelection="@InstalledItemSelection" />
            </Footer>
        </Grid>
    </div>
</ControlPanelPage>

<ControlPanelPage Title="@CommonVocabulary.BrowseVerb">
    <div class="packages-control-panel-page">
        <DescriptionBanner Title="@Localization.PackagesControlPanel.AvailableBannerTitle">
            @(string.Format(Localization.PackagesControlPanel.AvailableBannerDescription, PackageService.MinCoreVersion))
        </DescriptionBanner>
        <div class="input">

            <script>
                window.triggerUploadClick = () => { let label = window.document.getElementById("uploadtrigger"); label.click(); }
            </script>

            <label id="uploadtrigger"
                   for="item-upload">
                UPLOAD
            </label>

            <InputFile id="item-upload"
                       accept=".zip"
                       OnChange="OnFileChange" />
        </div>

        <Grid Items="@FilterAvailableItems(State.AvailableQueryable)" Virtualize="true" CssClass="packages-grid">
            <ActionButtons>
                <div style="display:contents;">
                    <AuthorizeView Policy="@AdminPolicy">
                        
                        <GridActionButton Text="@CommonVocabulary.InstallVerb"
                                          OnClick="InstallAvailablePackagesClick"
                                          IconCssClass="@_importIconCssClasses"
                                          Enabled="@CanInstallAvailablePackages()" />

                        <GridActionButton Text="@Common.Upload"
                                          OnClick="OnPackageUploadClickAsync"
                                          IconCssClass="@_exportIconCssClasses" />
                        
                        <GridActionButton Text="@CommonVocabulary.Delete"
                                          OnClick="@DeleteAvailablePackagesClick"
                                          IconCssClass="@_deleteIconCssClasses"
                                          Enabled="@CanDeleteAvailablePackages()" />

                        <GridActionButton Text="@CommonVocabulary.ResetVerb"
                                          OnClick="@(async () => await ResetAvailableSelectedModules())"
                                          IconCssClass="@_uninstallIconCssClasses"
                                          Enabled="@CanResetAvailableSelectedModules()" />
                    </AuthorizeView>
                </div>
            </ActionButtons>

            <Filter>
                <GridFilterControl @bind-Text="@State.AvailableFilterText" @bind-Text:after="@(() => InvokeAsync(StateHasChanged))" />
            </Filter>

            <ChildContent>
                <ItemSelectColumn KeySelector="@(item => item)"
                                  Selection="@AvailableItemSelection" />

                <TemplateColumn Title="@CommonVocabulary.Name">
                    @{
                        var key = new MarkupString(context.Name);

                        if (!string.IsNullOrEmpty(State.AvailableFilterText))
                            key = key.WithHighlightedText(State.AvailableFilterText);

                        @key
                    }
                </TemplateColumn>

                <TemplateColumn Title="@Localization.PackagesControlPanel.LatestVersion">
                    <div class="version-wrapper">
                        <div class="version">
                            @GetLatestVersion(context)
                        </div>
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="@CommonVocabulary.Status">
                    <div class="status-wrapper">
                        @if (context.Versions?.Any(k => k.IsLocal) == true)
                        {
                            <div title="@Localization.PackagesControlPanel.LocalAvailable" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.Folder" Size="MonochromeIconSize.SmallMedium" />
                            </div>
                        }

                        @if (context.PendingOperation is not null)
                        {
                            @if (context.PendingOperation.OperationKind is ClusterDependencyOperationKind.Install)
                            {
                                var tooltipText = context.InstalledVersion is null ?
                                string.Format(LibraryManagement.PendingInstallationOfSpecificVersion, context.PendingOperation.Dependency.Version.ToString()) :
                                string.Format(LibraryManagement.PendingUpdateToSpecificVersion, context.PendingOperation.Dependency.Version.ToString());

                                <div title="@tooltipText" class="icon-wrapper">
                                    <MonochromeIcon Name="MonochromeIconName.InstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                                </div>
                            }
                            else
                            {
                                <div title="@LibraryManagement.PendingUninstallation" class="icon-wrapper">
                                    <MonochromeIcon Name="MonochromeIconName.UninstallPendingLight" Size="MonochromeIconSize.SmallMedium" />
                                </div>
                            }
                        }

                    </div>
                </TemplateColumn>

                <NavigationColumn NavigationButtonTitle="@Common.ShowDetails"
                                  Navigate="@((ClusterPackageInfo item) => ShowDetailsAsync(item))" />
            </ChildContent>

            <Footer>
                <SelectionFooter GridSelection="@AvailableItemSelection" />
            </Footer>
        </Grid>
    </div>
</ControlPanelPage>
