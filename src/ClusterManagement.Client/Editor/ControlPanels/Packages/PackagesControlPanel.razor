@using ClusterManagement.Client.Editor.Enums
@using ClusterManagement.Client.Editor.Extensions
@using ClusterManagement.Client.Extensions
@using ClusterManagement.Client.Localization
@using ClusterManagement.Internal.Contracts
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Sdk.Client.Components.Settings
@using Sdk.Client.ControlPanels.Components
@using Sdk.Client.ControlPanels.Services
@using ViciOne.Ui.Blazor.Components.Grid.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components.ActionButtons
@using ViciOne.Ui.Blazor.Components.Grid.Components.Columns
@using ViciOne.Ui.Blazor.Components.Grid.Components.Footers
@using ViciOne.Ui.Blazor.Components.Grid.Components.Panes
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums
@using ViciOne.Ui.MonochromeIcons.Core.Extensions
@using ViciOne.Ui.Shared.Dx.Components

@inherits ControlPanelBase<ControlPanelState>

<ControlPanelPage Title="@Localization.Common.Title">
    <div class="packages-control-panel-page">
        <DescriptionBanner Title="@Localization.PackagesControlPanel.DescriptionBannerTitle">
            @(string.Format(Localization.PackagesControlPanel.DescriptionBannerDescription, PackageService.MinCoreVersion))
        </DescriptionBanner>
        <div class="input">

            <script>
                window.triggerUploadClick = () => { let label = window.document.getElementById("uploadtrigger"); label.click(); }
            </script>

            <label id="uploadtrigger"
                   for="item-upload">
                UPLOAD
            </label>

            <InputFile id="item-upload"
                       accept=".zip"
                       OnChange="OnFileChange" />
        </div>

        <Grid Items="@FilterItems(_packageInfosQueryable)" Virtualize="true" CssClass="packages-grid">
            <ActionButtons>
                <div style="display:contents;">
                    <AuthorizeView Policy="@AdminPolicy">
                        <GridActionButton Text="@Common.Upload" 
                                          OnClick="OnPackageUploadClickAsync"
                                          IconCssClass="@MonochromeIconName.Export.GetCssClasses(MonochromeIconSize.SmallMedium).ToSpaceSeparated()" />
                        <GridActionButton Text="@Localization.PackagesControlPanel.Uninstall"
                                          OnClick="@OnPackageDeleteClickAsync"
                                          IconData="@SvgIcon.Uninstall.GetPath()"
                                          Enabled="@(ItemSelection.Count != 0 && ItemSelection.All(i => !string.IsNullOrEmpty(i.InstalledVersion) && string.IsNullOrEmpty(i.RunningClusterVersion)))" />
                    </AuthorizeView>
                </div>
            </ActionButtons>

            <Filter>
                <GridFilterControl @bind-Text="@_filterText" @bind-Text:after="@(() => InvokeAsync(StateHasChanged))" />
            </Filter>

            <ChildContent>
                <ItemSelectColumn KeySelector="@(item => item)"
                                  Selection="@ItemSelection" />

                <TemplateColumn Title="@CommonVocabulary.Name">
                    @{
                        var key = new MarkupString(context.Name);

                        if (!string.IsNullOrEmpty(_filterText))
                            key = key.WithHighlightedText(_filterText);

                        @key
                    }
                </TemplateColumn>

                <TemplateColumn Title="@Localization.Common.InstalledVersion">
                    <div class="version-wrapper">
                        <div class="version" title="@context.InstalledVersion">
                            @context.InstalledVersion
                        </div>

                        @if (context.PendingOperation is not null)
                        {
                            @if (context.PendingOperation.OperationKind is ClusterDependencyOperationKind.Install)
                            {
                                var tooltipText = context.InstalledVersion is null ?
                                    string.Format(Localization.PackagesControlPanel.PendingInstallOfVersion, context.PendingOperation.Dependency.Version.ToString()) :
                                    string.Format(Localization.PackagesControlPanel.PendingUpdateToVersion, context.PendingOperation.Dependency.Version.ToString());

                                <div title="@tooltipText" class="icon-wrapper">
                                    <img src="@SvgIcon.InstallPending.GetPath()" />
                                </div>
                            }
                            else
                            {
                                <div title="@Localization.Common.PendingUninstall" class="icon-wrapper">
                                    <img src="@SvgIcon.UninstallPending.GetPath()" />
                                </div>
                            }
                        }

                        @if (context.LatestUpdateVersion is not null)
                        {
                            <div title="@string.Format(Localization.Common.UpdateToVersionAvailible, context.LatestUpdateVersion)" class="icon-wrapper">
                                <img src="@SvgIcon.UpdateAvailable.GetPath()" />
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(context.RunningClusterVersion))
                        {
                            <div title="@Localization.Common.ActiveInCluster" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.Lock" Size="MonochromeIconSize.Small" />
                            </div>
                        }

                        @if (context.Error is not null)
                        {
                            <div title="@context.Error.Message" class="icon-wrapper">
                                <MonochromeIcon Name="MonochromeIconName.ErrorFull" Size="MonochromeIconSize.Small" />
                            </div>
                        }
                    </div>
                </TemplateColumn>

                <NavigationColumn NavigationButtonTitle="@Common.ShowDetails"
                                  Navigate="@((ClusterPackageInfo item) => ShowDetailsAsync(item))" />
            </ChildContent>

            <Footer>
                <SelectionFooter GridSelection="@ItemSelection" />
            </Footer>
        </Grid>
    </div>
</ControlPanelPage>

<DxDialog @ref="@_refDeletePackagesDialog"
          CloseOnEscape="true"
          CloseOnOutsideClick="false"
          Header="@Localization.PackagesControlPanel.DeletePackagesHeader"
          Height="300px"
          IsTextOnly="true"
          Width="600px">

    <Body>
        <p class="dialog-content text-only">@Localization.PackagesControlPanel.DeletePackages</p>
    </Body>

    <Footer>
        <DxDialogFooterButton OnClick="@OnDeletePackagesOkAsync"
                              Text="@CommonVocabulary.Ok" />

        <DxDialogFooterButton OnClick="@OnDeletePackagesCloseAsync"
                              Text="@CommonVocabulary.Cancel" />
    </Footer>
</DxDialog>
