<div class="fb-tree-container @(GetStateCssClasses())">
    @if (!IsFunctionBlock)
    {
        <div @onpointerdown="FunctionBlockModel.ToggleIsExpanded"
             class="dropdown-icon @(FunctionBlockModel.IsExpanded ? "expanded" : string.Empty)">

            <svg>
                <path d="M2 2l5 3-5 3z"></path>
            </svg>
        </div>

        <span class="header-text">
            <DxCheckBox Checked="FunctionBlockModel!.Checked"
                        CheckedChanged="(async (bool? b) => await OnCheckedChanged(b))">
                @FunctionBlockModelTemplate(FunctionBlockModel)
            </DxCheckBox>
        </span>

        if (IsSubLayer && HasSiblings && !IsLastSibling)
        {
            <div class="orientation-guide line">
                <span />
                <span />
            </div>
        }

        <div class="sub-layer-container">
            @foreach (var child in FunctionBlockModel.FunctionBlocks)
            {
                <LoadFunctionBlockTree IsVisible=FunctionBlockModel.IsExpanded
                                       Layer="@(Layer + 1)"
                                       FunctionBlockModel="@child"
                                       Parent="this"
                                       FunctionBlockModelTemplate="FunctionBlockModelTemplate"/>
            }
        </div>   
    }
    else
    {
        <div class="orientation-guide @(IsLastSibling ? "end" : "branch")">
            <span />
            <span />
        </div>

        <div class="sub-layer-container"
             title="@FunctionBlockModel!.Name">

            <DxCheckBox Checked="FunctionBlockModel!.Checked"
                        CheckedChanged="(async (bool? b) => await OnCheckedChanged(b))">
                @FunctionBlockModelTemplate(FunctionBlockModel)
            </DxCheckBox>
        </div>
    }
</div>
