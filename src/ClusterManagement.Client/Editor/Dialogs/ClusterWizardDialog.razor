@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Localization.Resources

<Dialog @ref="_refDialog"
        OnClosing="() => WizardService.DisplayDialog = false"
        HeaderText="@(WizardService.CurrentWizard?.Title ?? "Title")"
        Height="440"
        Width="620">

    <Body>
        @if (WizardService.CurrentWizard is not null)
        {
            <DynamicComponent Type="@(WizardService.CurrentWizard.ComponentType)" @ref="_wizardComponent" />
        }
        else
        {
            <p>@Localization.ClusterWizardDialog.WizardIsNotAvailable</p>
        }
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@WizardService.ProcessCurrentWizard"
                            Id="@GenerateButtonId"
                            Enabled="@WizardService.CanProcess"
                            Text="@CommonVocabulary.Generate" />

        <DialogFooterButton OnClick="() => WizardService.DisplayDialog = false"
                            Id="@CancelButtonId"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>
