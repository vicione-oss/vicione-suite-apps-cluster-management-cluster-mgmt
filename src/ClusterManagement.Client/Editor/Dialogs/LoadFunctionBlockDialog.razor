@using ClusterManagement.Client.Editor.Components
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.ClusterEditor.Components.ToolbarSearchbox
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<Dialog @ref="_refDialog"
        OnClosing="@CloseDialog"
        HeaderText="@Localization.LoadFunctionBlockDialog.Header"
        Height="70%"
        OnShowing="@OnShowing"
        MinimumWidth="800px">

    <HeaderSlot>
        <Toolbar>
            <ToolbarGroup AlignRight="true">
                <ToolbarSearchbox Text="@_searchText"
                                  TextChanging="SearchTextChanging" />

                <ToolbarButton IconName="@MonochromeIconName.ExpandAll"
                               OnClick="@(() => _selection?.ExpandAll())"
                               Text="@_localizeExpandAllGroups"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.CollapseAll"
                               OnClick="@(() => _selection?.CollapseAll())"
                               Text="@_localizeCollapseAllGroups"
                               TextVisibility="@TextVisibility.MenuOnly" />
            </ToolbarGroup>
        </Toolbar>        
    </HeaderSlot>    

    <Body>
        <FunctionBlockSelection @ref="_selection"
                                Dependencies="@_availableDependencies"
                                Filter="@_searchText"
                                CheckedDependenciesChanged="@OnCheckedDependenciesChanged" />
    </Body>
    <Footer>
        <DialogFooterButton OnClick="@OnOkButtonClick"
                            Enabled="@(_checkedDependencies.Count > 0)"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@CloseDialog"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>
