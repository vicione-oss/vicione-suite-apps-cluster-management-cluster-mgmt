@using ClusterManagement.Client.Editor.Components
@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.SearchBox
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Toolbar.Enums
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Core.Enums

<Dialog @ref="_refDialog"
        OnClosing="@CloseDialog"
        HeaderText="@Localization.LoadFunctionBlockDialog.Header"
        Height="70%"
        OnShowing="@ResetTree"
        Width="70%">

    <HeaderSlot>
        <Toolbar>
            <ToolbarGroup AlignRight="true">
                <ToolbarContent>
                    <div class="search-container">
                        <SearchBox @bind-Text="@_filter"
                                   @bind-Text:after="@(async () => await ShowFilteredFunctionBlocks())"
                                   Placeholder="@CommonVocabulary.Search" />
                    </div>
                </ToolbarContent>
            </ToolbarGroup>

            <ToolbarGroup AlignRight="true">
                <ToolbarButton IconName="@MonochromeIconName.ExpandAll"
                               OnClick="OnExpandAllClick"
                               Text="@_localizeExpandAllGroups"
                               TextVisibility="@TextVisibility.MenuOnly" />

                <ToolbarButton IconName="@MonochromeIconName.CollapseAll"
                               OnClick="OnCollapseAllClick"
                               Text="@_localizeCollapseAllGroups"
                               TextVisibility="@TextVisibility.MenuOnly" />
            </ToolbarGroup>
        </Toolbar>
    </HeaderSlot>

    <Body>
        <div class="content-container">
            <div class="all">
                <CheckBox Value="_functionBlockTreeRoot.Checked"
                          ValueChanged="@((bool? b) => OnCheckedChanged(b))">
                </CheckBox>
                <span class="text">@CommonVocabulary.All</span>
            </div>

            @if (_functionBlockTreeRoot.FunctionBlocks.Any())
            {
                <div class="relative-container">
                    <div class="absolute-container">
                        @foreach (var child in _functionBlockTreeRoot.FunctionBlocks)
                        {
                            <LoadFunctionBlockTree CheckChanged="async () => await InvokeAsync(StateHasChanged)"
                                                   FunctionBlockModel="@child"
                                                   IsVisible="true"
                                                   Layer="0">

                                <FunctionBlockModelTemplate>
                                    @context.Name
                                </FunctionBlockModelTemplate>
                            </LoadFunctionBlockTree>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="wrapper">
                    <div>@Localization.LoadFunctionBlockDialog.NoFunctionBlockAvailable</div>
                </div>
            }
        </div>
    </Body>
    <Footer>
        <DialogFooterButton OnClick="@OnOkButtonClick"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@CloseDialog"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>
