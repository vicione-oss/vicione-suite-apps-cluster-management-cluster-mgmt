@using Sdk.Client.Components.Settings
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.Localization.Resources

<Dialog @ref="_refDialog"
        OnClosing="() => SaveService.DisplayDialog = false"
        HeaderText="@Localization.SaveClusterDialog.Header"
        Height="350"
        Width="650">
    <Body>
        <SettingsLayout ContentPaddingRight="32">
            <SettingsGroup Title="@CommonVocabulary.PropertyPlural">
                <SettingsField Label="@CommonVocabulary.Name">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Name" @bind-Value="SaveService.Name" Enabled="@(!SaveService.IsWorking)" />
                </SettingsField>

                <SettingsField Label="@CommonVocabulary.Description">
                    <SettingsFieldTextBox Placeholder="@CommonVocabulary.Description" @bind-Value="SaveService.Description" Enabled="@(!SaveService.IsWorking)" />
                </SettingsField>

                <SettingsField Label="@Localization.SaveClusterDialog.CleanupDependencies">
                    <CheckBox @bind-Value="SaveService.StoreOptions.CleanupDependencies" Enabled="@(!SaveService.IsWorking)" />
                </SettingsField>
            </SettingsGroup>

            @if (SaveService.ConfirmationMessage?.IsError == true)
            {
                <SettingsGroup Title="@CommonVocabulary.Error">
                    <SettingsInformation>
                        @SaveService.ConfirmationMessage?.Message
                    </SettingsInformation>
                </SettingsGroup>
            }
        </SettingsLayout>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@SaveService.Save"
                            Enabled="@(SaveService.Builder != null && !SaveService.IsWorking)"
                            Text="@CommonVocabulary.Save" />

        <DialogFooterButton OnClick="() => SaveService.DisplayDialog = false"
                            Enabled="@(!SaveService.IsWorking)"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>
