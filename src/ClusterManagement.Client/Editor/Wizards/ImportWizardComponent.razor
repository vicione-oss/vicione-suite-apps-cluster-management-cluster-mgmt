@using ClusterManagement.Client.Editor.Localization
@using ClusterManagement.Client.Editor.Wizards.Services
@using Sdk.Client.Components.FileDrop
@using Sdk.Client.Components.Settings
@using ViciOne.Cluster.Model
@using ViciOne.Ui.Blazor.Components.CheckBox
@using ViciOne.Ui.Localization.Resources

@inject ImportWizardService Wizard

<SettingsLayout>
    <SettingsGroup Title="@ImportWizard.GroupHeader">
        <SettingsField Label="@TechnicalTerms.FileSelection">
            <FileDropComponent OnChange="@Wizard.UploadClusterJsonFile" />
        </SettingsField>

        <SettingsField Label="@($"{TechnicalTerms.FileSize} (max.{ImportWizardService.MaxFileSize})")">
            @Wizard.FileSize
        </SettingsField>

        <SettingsField Label="@(string.Format(ImportWizard.MergeItemX, nameof(ClusterNodeGroup)))">
            <CheckBox @bind-Value="@Wizard.Options.MergeNodeGroups" />
        </SettingsField>

        <SettingsField Label="@(string.Format(ImportWizard.MergeItemX, nameof(ClusterNode)))">
            <CheckBox @bind-Value="@Wizard.Options.MergeNodes" />
        </SettingsField>

        <SettingsField Label="@(string.Format(ImportWizard.MergeItemX, nameof(ClusterApplication)))">
            <CheckBox @bind-Value="@Wizard.Options.MergeApplications" />
        </SettingsField>

        <SettingsField Label="@(string.Format(ImportWizard.MergeItemX, nameof(EngineHost)))">
            <CheckBox @bind-Value="@Wizard.Options.MergeEngineHosts" />
        </SettingsField>
    </SettingsGroup>
</SettingsLayout>
