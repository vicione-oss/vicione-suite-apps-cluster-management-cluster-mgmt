@using System.Globalization
@using ClusterManagement.Client.Editor.Extensions
@using ClusterManagement.Client.IoddManagement.ControlPanels.Services
@using ClusterManagement.Client.IoddManagement.Models
@using Sdk.Authorization
@using Sdk.Client.Components.Settings
@using Sdk.Client.Components.Settings.Expanders
@using Sdk.Client.ControlPanels.Components
@using ViciOne.Ui.Blazor.Components.Dialog.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components
@using ViciOne.Ui.Blazor.Components.Grid.Components.Columns
@using ViciOne.Ui.Blazor.Components.Grid.Components.Panes
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.TreeEditor

@attribute [ModuleAuthorize<ClusterManagementClientModule>(AccessLevel.Full)]

@inherits ControlPanelBase<IoddControlPanelState>

<ControlPanelPage Title="@Localization.IoddControlPanel.Manual">
    <div class="iodds-control-panel-page">
        <DescriptionBanner Title="@Localization.IoddControlPanel.ManualIoLinkConfiguration">
            @Localization.IoddControlPanel.ManualIoLinkConfigurationDescription
        </DescriptionBanner>

        <Grid Items="@FilterItems(_itemsQueryable)" Virtualize="true" CssClass="iodds-grid">
            <ActionButtons>
                <div class="iodd-action-buttons">
                    <SettingsFieldFileUpload @ref="_fileUpload"
                                             @bind-Filename="_uploadedFilename"
                                             Accept=".zip"
                                             ChooseButtonText="@Client.Localization.Common.Upload"
                                             ChooseButtonIconCssClasses="@_uploadIconCssClasses"
                                             HideFilename="true"
                                             MaximumAllowedSize="@ControlPanelConstants.TwoMB"
                                             OnUploadStart="@OnIoddUploadStart"
                                             OnUploadSuccess="@OnIoddUploadSuccess"
                                             OnUploadError="@OnIoddUploadError"
                                             OnUploadCancel="@OnIoddUploadCancel"
                                             Placeholder="@Client.Localization.Common.Upload"
                                             UploadTicketFactory="@UploadTicketFactory"
                                             UploadTicket="@UploadTicket"
                                             UploadHandler="@StreamUploadHandler" />

                    <SettingsFieldButton Text="@CommonVocabulary.DownloadVerb"
                                         Enabled="@(ItemSelection.Any())"
                                         OnClick="@OnIoddDownloadClickAsync"
                                         IconCssClass="@_importIconCssClasses" />

                    <SettingsFieldButton Text="@CommonVocabulary.Delete"
                                         OnClick="@OnIoddDeleteClickAsync"
                                         Enabled="@(ItemSelection.Any())"
                                         IconCssClass="@_deleteIconCssClasses" />
                </div>
            </ActionButtons>

            <Filter>
                <GridFilterControl @bind-Text="@State.FilterText" @bind-Text:after="@(() => InvokeAsync(StateHasChanged))" />
            </Filter>

            <ChildContent>
                <LeftPane CssClass="tree-pane">
                    <div style="display:contents">
                        <TreeEditor Builder="@_treeBuilder" />
                    </div>
                </LeftPane>

                <ItemSelectColumn KeySelector="@(item => new IoddSelectionId(item.VendorId, item.DeviceId, item.ProductId))"
                                  Selection="@ItemSelection" />

                <TemplateColumn Title="@CommonVocabulary.Name">
                    @{
                        var key = new MarkupString(context.Name);

                        if (!string.IsNullOrEmpty(State.FilterText))
                            key = key.WithHighlightedText(State.FilterText);

                        @key
                    }
                </TemplateColumn>

                <TemplateColumn Title="@Localization.Common.DeviceId">
                    @{
                        var value = new MarkupString(context.DeviceId.ToString(CultureInfo.InvariantCulture));

                        if (!string.IsNullOrEmpty(State.FilterText))
                            value = value.WithHighlightedText(State.FilterText);

                        @value
                    }
                </TemplateColumn>

                <PropertyColumn Property="@(item => item.UploadedAt)"
                                Title="@Localization.Common.UploadedAt" />

                <NavigationColumn NavigationButtonTitle="@Client.Localization.Common.ShowDetails"
                                  Navigate="@((DeviceView item) => ShowDetailsAsync(item))" />
            </ChildContent>

            <Footer>
                <div>@GetFooterString()</div>
            </Footer>
        </Grid>
    </div>
</ControlPanelPage>

<ControlPanelPage Title="@Localization.IoddControlPanel.Automatic">

    <DescriptionBanner Title="@Localization.IoddControlPanel.AutomaticIoLinkDownload">
        @Localization.IoddControlPanel.AutomaticIoLinkDownloadDescription
    </DescriptionBanner>

    <SettingsLayout>
        <SettingsGroup Expanded="true"
                       Title="@Localization.IoddControlPanel.AutomaticDownloadFromFinder">
            <Expander>
                <SwitchExpander Value="@State.AutoDownload"
                                ValueChanged="@AutoDownloadValueChanged"
                                IsLoading="@State.WaitingForAutoDownloadChange" />
            </Expander>
        </SettingsGroup>
    </SettingsLayout>
</ControlPanelPage>

<Dialog @ref="@_refDeleteIoddsDialog"
        HeaderText="@Localization.IoddControlPanel.DeleteIoddsHeader"
        Height="300px"
        Width="600px">

    <Body>
        <DialogBodyTextLayout>
            <p class="dialog-content text-only">@Localization.IoddControlPanel.DeleteIodds</p>
        </DialogBodyTextLayout>
    </Body>

    <Footer>
        <DialogFooterButton OnClick="@OnDeleteIoddsOkAsync"
                            Text="@CommonVocabulary.Ok" />

        <DialogFooterButton OnClick="@OnDeleteIoddsCloseAsync"
                            Text="@CommonVocabulary.Cancel" />
    </Footer>
</Dialog>
