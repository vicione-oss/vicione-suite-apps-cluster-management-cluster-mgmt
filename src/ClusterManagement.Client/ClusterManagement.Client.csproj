<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AssemblyName>ViciOne.Suite.ClusterManagement.Client</AssemblyName>
    <CompressionEnabled>false</CompressionEnabled>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.SassCompiler" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MQTTnet" />
    <PackageReference Include="ViciOne.Suite.Sdk.Client" />
    <PackageReference Include="ViciOne.Ui.ClusterEditor" />
    <PackageReference Include="ViciOne.Ui.Design">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ViciOne.Ui.MonochromeIcons.Assets">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ViciOne.Ui.Localization" />
    <PackageReference Include="ViciOne.Ui.TreeEditor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClusterManagement.Internal\ClusterManagement.Internal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ViciOne.Suite.ClusterManagement.Client.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- Prevent Microsoft.NET.Sdk.Razor from copying unnecessary file -->
  <ItemGroup>
    <Content Update="sasscompiler.json;tsconfig.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="package*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="DataflowEvents\Localization\DataflowEventsPage.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>DataflowEventsPage.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\ClusterEditorSettings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ClusterEditorSettings.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\SaveClusterDialog.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SaveClusterDialog.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\ClusterTopologyEditDialog.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ClusterTopologyEditDialog.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\ClusterWizardDialog.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ClusterWizardDialog.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\LoadFunctionBlockDialog.Designer.cs">
      <DesignTime>True</DesignTime>
