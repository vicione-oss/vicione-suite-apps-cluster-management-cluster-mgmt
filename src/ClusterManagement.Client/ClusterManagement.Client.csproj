    </Compile>
    <Compile Update="Editor\Localization\Common.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Common.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\PackagesControlPanel.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PackagesControlPanel.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\PackageDetailsControlPanel.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>PackageDetailsControlPanel.resx</DependentUpon>
    </Compile>
    <Compile Update="IoddManagement\Localization\IoddControlPanel.Designer.cs">
      <DependentUpon>IoddControlPanel.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="IoddManagement\Localization\Common.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Common.resx</DependentUpon>
    </Compile>
    <Compile Update="IoddManagement\Localization\IoddDetailsControlPanel.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>IoddDetailsControlPanel.resx</DependentUpon>
    </Compile>
    <Compile Update="Localization\ClusterTerms.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ClusterTerms.resx</DependentUpon>
    </Compile>
    <Compile Update="Localization\Common.Designer.cs">
      <DependentUpon>Common.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Management\Localization\ClusterTopologyInfoDialog.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ClusterTopologyInfoDialog.resx</DependentUpon>
    </Compile>
    <Compile Update="Management\Localization\Common.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
