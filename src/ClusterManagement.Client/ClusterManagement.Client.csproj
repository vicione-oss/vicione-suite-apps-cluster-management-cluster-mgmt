    </Compile>
    <Compile Update="Resources\SvgIcons.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>SvgIcons.resx</DependentUpon>
    </Compile>
    <Compile Update="Editor\Localization\ImportWizard.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>ImportWizard.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="DataflowEvents\Localization\DataflowEventsPage.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>DataflowEventsPage.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Editor\Localization\ClusterEditorSettings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>ClusterEditorSettings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Editor\Localization\SaveClusterDialog.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>SaveClusterDialog.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Editor\Localization\ClusterTopologyEditDialog.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>ClusterTopologyEditDialog.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Editor\Localization\ClusterWizardDialog.resx">
