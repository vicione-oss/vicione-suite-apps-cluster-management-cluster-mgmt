    <EmbeddedResource Update="Editor\Localization\Common.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Common.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Editor\Localization\PackagesControlPanel.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>PackagesControlPanel.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Editor\Localization\PackageDetailsControlPanel.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>PackageDetailsControlPanel.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="IoddManagement\Localization\IoddControlPanel.resx">
      <LastGenOutput>IoddControlPanel.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="IoddManagement\Localization\Common.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Common.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="IoddManagement\Localization\IoddDetailsControlPanel.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>IoddDetailsControlPanel.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Localization\ClusterTerms.resx">
