@using ClusterManagement.Client.Extensions
@using ClusterManagement.Client.Management.Components
@using ClusterManagement.Client.Management.Extensions
@using ClusterManagement.Client.Management.Localization
@using Sdk.Authorization
@using ViciOne.Ui.Localization.Resources

@inherits ModulePageBase<ClusterManagementClientModule>
@attribute [Route(DebugConstants.DebugEnginesRoute)]
@attribute [ModuleAuthorize<ClusterManagementClientModule>(AccessLevel.Full)]

<div class="debug-engines">
    <ClusterPageBar Page="@ClusterPage.Engines"
                    ClusterName="@_cluster?.Name"
                    ClusterId="@_cluster?.Id"
                    RunningVersion="@_cluster?.Version"
                    IsLoading="@(!_hasLoaded)" />

    @{ var hosts = SortedHosts(); }
    @if (!_hasLoaded)
    {
        <LoadingSpinner Visible="true" />
    }
    else if (_cluster is null)
    {
        <p class="empty muted">@ClusterOverview.NoVersionRunning</p>
    }
    else if (hosts.Count == 0)
    {
        <p class="empty muted">@ClusterOverview.NoEngines</p>
    }
    else
    {
        @* One group per engine host, its engines below it in the order they run in its cycle. *@
        <section class="engines">
            <table class="@(Expert ? "expert" : null)">
                <colgroup>
                    <col class="name-column" />
                    @if (Expert)
                    {
                        <col class="order-column" />
                        <col class="id-column" />
                    }
                    <col class="state-column" />
                    <col class="cycle-column" />
                    @if (Expert)
                    {
                        <col class="range-column" />
                        <col class="count-column" />
                        <col class="level-column" />
                        <col class="actions-column" />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th>@ClusterOverview.EngineColumn</th>
                        @if (Expert)
                        {
                            <th title="@ClusterOverview.RunIndexHint">@ClusterOverview.RunIndexColumn</th>
                            <th>@TechnicalTerms.Id</th>
                        }
                        <th>@CommonVocabulary.State</th>
                        <th>@ClusterOverview.LatestCycle</th>
                        @if (Expert)
                        {
                            <th title="@ClusterOverview.CycleRangeColumnHint">@ClusterOverview.CycleRangeColumn</th>
                            <th>@ClusterOverview.FunctionBlocks</th>
                            <th>@ClusterOverview.LogLevelColumn</th>
                            <th>@CommonVocabulary.ActionPlural</th>
                        }
                    </tr>
                </thead>
                @foreach (var host in hosts)
                {
                    var latestChainCycle = _tracker.Series.Latest(host.Id, _now);
                    var reporting = _tracker.IsReporting(host, _now);
                    var isOverCycleTime = IsOverCycleTime(host);
                    <tbody @key="host.Id">
                        <tr class="host">
                            @* In the Expert view the id of the host stands in the column of the engine ids, whatever labels its name has.
                               The Standard view has no column for the summary; it ends the line, and a long name gives way to it. *@
                            <td colspan="@(Expert ? 2 : ColumnCount)">
                                <div class="host-row">
                                    <span class="dot status-@(reporting ? "running" : "previous")"
                                          title="@(reporting ? ClusterOverview.HostReporting : ClusterOverview.HostNotReporting)"></span>
                                    <span class="host-name" title="@HoverTexts.NameWithDescription(host.Name, host.Description)">@host.Name</span>
                                    <span class="instance muted">@string.Format(ClusterOverview.OnNode, InstanceName(host))</span>
                                    @if (!Expert)
                                    {
                                        <span class="host-summary">
                                            <span class="muted">@host.Engines.RunningText(_tracker.IsDeploying)</span>
                                            <span class="cycle @(isOverCycleTime ? "over" : null)" title="@HostCycleTitle(isOverCycleTime)">@HostCycleText(host, latestChainCycle)</span>
                                        </span>
                                    }
                                </div>
                            </td>
                            @if (Expert)
                            {
                                <td class="mono muted" title="@host.Id">@host.Id</td>
                                <td colspan="@(ColumnCount - 3)">
                                    <div class="host-row host-summary">
                                        @if (host.ElevatedPrivileges)
                                        {
                                            <span class="chip status-default">@ClusterOverview.Privileged</span>
                                        }
                                        <span class="muted">@host.Engines.RunningText(_tracker.IsDeploying)</span>
                                        @if (RangeOf(host.Id) is { } chainRange)
                                        {
                                            <span class="cycle-range mono muted" title="@RangeHint(chainRange)">@CycleTimeTexts.Range(chainRange)</span>
                                        }
                                        <span class="cycle @(isOverCycleTime ? "over" : null)" title="@HostCycleTitle(isOverCycleTime)">@HostCycleText(host, latestChainCycle)</span>
                                    </div>
                                </td>
                            }
                        </tr>
                        @foreach (var engine in EnginesInOrder(host))
                        {
                            var details = DetailsOf(engine);
                            <tr class="engine" @key="engine.EngineId">
                                <td>
                                    <span class="engine-name" title="@HoverTexts.NameWithDescription(engine.EngineName, engine.Description)">@engine.EngineName</span>
                                    @if (!details.Enabled)
                                    {
                                        <span class="chip status-default">@ClusterOverview.EngineDisabled</span>
                                    }
                                </td>
                                @if (Expert)
                                {
                                    <td class="mono">@details.RunIndex</td>
                                    <td class="mono muted" title="@engine.EngineId">@engine.EngineId</td>
                                }
                                <td>
                                    <span class="state">
                                        <span class="dot status-@engine.StatusName(_tracker.IsDeploying)"></span>
                                        @engine.StateText(_tracker.IsDeploying)
                                    </span>
                                </td>
                                <td class="mono">@CycleTimeTexts.Milliseconds(LatestCycle(engine))</td>
                                @if (Expert)
                                {
                                    var range = engine.DeploymentId is { } deploymentId ? RangeOf(deploymentId) : null;
                                    <td class="cycle-range mono" title="@(range is { } known ? RangeHint(known) : null)">@(range is { } shown ? CycleTimeTexts.Range(shown) : "–")</td>
                                    <td class="mono">@details.FunctionBlocks</td>
                                    <td>@details.LogLevel</td>
                                    <td>
                                        <EngineActions Engine="@engine"
                                                       MayControl="@_mayControlEngines"
                                                       Deploying="@_tracker.IsDeploying"
                                                       OnStart="@StartEngine"
                                                       OnStop="@StopEngine"
                                                       OnTearDown="@AskToTearDown"
                                                       OnShowPackages="@ShowPackages" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                }
            </table>
        </section>
    }

    <EngineDialogs @ref="@_dialogs" OnTearDownConfirmed="@TearDownEngine" />
</div>
