@using Sdk.Authorization
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Popup.Components
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@inherits ModulePageBase<ClusterManagementClientModule>
@attribute [Route(DebugConstants.DebugEnginesRoute)]
@attribute [ModuleAuthorize<ClusterManagementClientModule>(AccessLevel.Full)]

<div class="debug-engines">
    <div class="debug-engines-toolbar">
        <Toolbar>
            <ToolbarGroup>
                <ToolbarContent Enabled="false">
                    @_clusterInfoText
                </ToolbarContent>
            </ToolbarGroup>
            <ToolbarGroup AlignRight="true">
                <ToolbarButton Text="@CommonVocabulary.Management"
                               OnClick="@NavigateToManagement"
                               IconName="@MonochromeIconName.DataflowLight" />

                <ToolbarButton Text="@TechnicalTerms.EventPlural"
                               OnClick="@NavigateToEvents"
                               IconName="@MonochromeIconName.Properties" />
            </ToolbarGroup>
        </Toolbar>
    </div>

    @if (!_hasLoaded)
    {
        <LoadingSpinner Visible="true" />
    }
    else
    {
        <div class="debug-engines-grid">
            <SimpleTable TItem="EngineInfoModel"
                         Items="@Engines"
                         SortingState="@_sortingState">
                <Columns>
                    <SimpleTableTemplateColumn Id="@EngineHostNameColumnId" Title="Engine-Host Name" Resizeable="false"
                                               SortExpression="@(m => m.EngineHostName)">
                        <CellContent>@context.EngineHostName</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="EngineHostId" Title="Engine-Host ID" Resizeable="false">
                        <CellContent>@context.EngineHostId</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="EngineId" Title="Engine ID" Resizeable="false">
                        <CellContent>@context.EngineId</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="@EngineNameColumnId" Title="Engine Name" Resizeable="false"
                                               SortExpression="@(m => m.EngineName)">
                        <CellContent>@context.EngineName</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="EngineState" Title="Engine State" Resizeable="false">
                        <CellContent>@context.EngineState</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="Actions" Title="@CommonVocabulary.ActionPlural" Resizeable="false" Width="150">
                        <CellContent><div class="action-column">
                            <Button IconCssClass="@_startIconCssClass"
                                    OnClick="@(async () => await StartEngine(context))"
                                    Enabled="@(context.EngineState is Internal.Requests.EngineState.Stopped)"
                                    Title="@CommonVocabulary.StartVerb"
                                    Size="@ButtonSize.Small" />

                            <Button IconCssClass="@_stopIconCssClass"
                                    OnClick="@(async () => await StopEngine(context))"
                                    Enabled="@(context.EngineState is Internal.Requests.EngineState.Running)"
                                    Title="Stop"
                                    Size="@ButtonSize.Small" />

                            <Button IconCssClass="@_trashIconCssClass"
                                    OnClick="@(async () => await TearDownEngine(context))"
                                    Enabled="@(context.EngineState is Internal.Requests.EngineState.Stopped)"
                                    Title="TearDown"
                                    Size="@ButtonSize.Small" />

                            <Button IconCssClass="@_infoIconCssClass"
                                    OnClick="@(async () => await GetPackages(context))"
                                    Title="Get Packages"
                                    Size="@ButtonSize.Small" />
                        </div></CellContent>
                    </SimpleTableTemplateColumn>
                </Columns>
            </SimpleTable>
            <Popup @bind-Visible="_showPackages"
                   Width="300px">
                <PopupHeaderBodyLayout HeaderText="Installed Packages">
                    <Body>
                        <div style="max-height:250px; overflow-y:auto;">
                            <table class="table table-striped table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Package</th>
                                        <th>Version</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kv in Packages.OrderBy(p => p.Key))
                                    {
                                        <tr>
                                            <td>@kv.Key</td>
                                            <td>@kv.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </Body>
                </PopupHeaderBodyLayout>
            </Popup>
        </div>
    }
</div>
