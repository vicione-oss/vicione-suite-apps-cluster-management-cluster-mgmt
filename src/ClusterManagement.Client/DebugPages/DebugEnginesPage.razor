@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Blazor.Components.Popup.Components
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Components
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@inherits ModulePageBase<ClusterManagementClientModule>
@attribute [Route(DebugConstants.DebugEnginesRoute)]

<div class="debug-engines">
    <div class="debug-engines-toolbar">
        <Toolbar>
            <ToolbarGroup>
                <ToolbarContent Enabled="false">
                    @_clusterInfoText
                </ToolbarContent>
            </ToolbarGroup>
            <ToolbarGroup AlignRight="true">
                <ToolbarButton Text="@CommonVocabulary.Management"
                               OnClick="@NavigateToManagement"
                               IconName="@MonochromeIconName.DataflowLight" />

                <ToolbarButton Text="@TechnicalTerms.EventPlural"
                               OnClick="@NavigateToEvents"
                               IconName="@MonochromeIconName.Properties" />
            </ToolbarGroup>
        </Toolbar>
    </div>

    @if (!_hasLoaded)
    {
        <LoadingSpinner Visible="true" />
    }
    else
    {
        <div class="debug-engines-grid">
            <DxGrid AllowGroup="true"
                    Data="@Engines"
                    AutoExpandAllGroupRows="true"
                    PagerVisible="true">
                <Columns>
                    <DxGridDataColumn Caption="Engine-Host ID"
                                      FieldName="@nameof(EngineInfoModel.EngineHostId)"
                                      GroupIndex="0" />
                    <DxGridDataColumn Caption="Engine-Host Name"
                                      FieldName="@nameof(EngineInfoModel.EngineHostName)" />
                    <DxGridDataColumn Caption="Engine ID"
                                      FieldName="@nameof(EngineInfoModel.EngineId)" />
                    <DxGridDataColumn Caption="Engine Name"
                                      FieldName="@nameof(EngineInfoModel.EngineName)" />
                    <DxGridDataColumn Caption="Engine State"
                                      FieldName="@nameof(EngineInfoModel.EngineState)" />
                    <DxGridCommandColumn Width="150px">
                        <HeaderTemplate>
                            @CommonVocabulary.ActionPlural
                        </HeaderTemplate>
                        <CellDisplayTemplate>
                            <div class="action-column">
                                @if (context.DataItem is EngineInfoModel model)
                                {
                                    <Button IconCssClass="@_startIconCssClass"
                                            OnClick="@(async () => await StartEngine(model))"
                                            Enabled="@(model.EngineState is Internal.Requests.EngineState.Stopped)"
                                            Title="@CommonVocabulary.StartVerb"
                                            Size="@ButtonSize.Small" />

                                    <Button IconCssClass="@_stopIconCssClass"
                                            OnClick="@(async () => await StopEngine(model))"
                                            Enabled="@(model.EngineState is Internal.Requests.EngineState.Running)"
                                            Title="Stop"
                                            Size="@ButtonSize.Small" />


                                    <Button IconCssClass="@_trashIconCssClass"
                                            OnClick="@(async () => await TearDownEngine(model))"
                                            Enabled="@(model.EngineState is Internal.Requests.EngineState.Stopped)"
                                            Title="TearDown"
                                            Size="@ButtonSize.Small" />

                                    <Button IconCssClass="@_infoIconCssClass"
                                            OnClick="@(async () => await GetPackages(model))"
                                            Title="Get Packages"
                                            Size="@ButtonSize.Small" />
                                }
                            </div>
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                </Columns>
            </DxGrid>
            <Popup @bind-Visible="_showPackages"
                   Width="300px">
                <PopupHeaderBodyLayout HeaderText="Installed Packages">
                    <Body>
                        <div style="max-height:250px; overflow-y:auto;">
                            <table class="table table-striped table-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th>Package</th>
                                        <th>Version</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var kv in Packages.OrderBy(p => p.Key))
                                    {
                                        <tr>
                                            <td>@kv.Key</td>
                                            <td>@kv.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </Body>
                </PopupHeaderBodyLayout>
            </Popup>
        </div>
    }
</div>
