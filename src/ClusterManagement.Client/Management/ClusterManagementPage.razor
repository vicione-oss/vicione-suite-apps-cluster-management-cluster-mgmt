@using ClusterManagement.Client.Management.Components;
@using ClusterManagement.Client.Management.Models
@using ClusterManagement.Public
@using Sdk.Authorization
@using ViciOne.Cluster.Model
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@attribute [Route(Constants.ManagementModuleRoute)]
@attribute [ModuleAuthorize<ClusterManagementClientModule>(AccessLevel.Full)]

@inherits ModulePageBase<ClusterManagementClientModule>


<div class="cluster-mgmt">
    <div class="cluster-mgmt-toolbar">
        <Toolbar>
            <ToolbarGroup>
                <ToolbarContent Enabled="false" Tooltip="@SelectedCluster?.Key">
                    @(SelectedCluster != null ? SelectedCluster.DisplayNameVersion : string.Empty)
                </ToolbarContent>
            </ToolbarGroup>
            <ToolbarGroup AlignRight="true">
                <ToolbarButton Text="@(string.Format(UserActions.ResetSomething, "Saga"))"
                               OnClick="@ResetSagaStates"
                               IconName="@MonochromeIconName.Delete" />

                <ToolbarButton Text="@(string.Format(UserActions.GetSomething, "Saga"))"
                               OnClick="@GetSagaState"
                               IconName="@MonochromeIconName.Reload" />

                <ToolbarButton Text="@TechnicalTerms.EventPlural"
                               OnClick="@NavigateToEvents"
                               IconName="@MonochromeIconName.Properties" />
            </ToolbarGroup>
        </Toolbar>
    </div>

    @if (!_hasLoaded)
    {
        <LoadingSpinner Visible="true" />
    }
    else
    {
        <div class="cluster-mgmt-grid">
            <DxGrid AllowSelectRowByClick="true"
                    AllowGroup="false"
                    AutoCollapseDetailRow="true"
                    Data="@Clusters"
                    PagerVisible="true"
                    KeyFieldName="@nameof(ClusterInfoModel.Key)"
                    SelectionMode="GridSelectionMode.Single"
                    SelectedDataItem="@SelectedCluster"
                    SelectedDataItemChanged="@SelectedClusterChanged">
                <Columns>
                    <DxGridDataColumn Caption="@CommonVocabulary.Name"
                                      FieldName="@nameof(ClusterInfoModel.DisplayName)"
                                      MinWidth="150" Width="35%" />

                    <DxGridDataColumn AllowGroup="false"
                                      Caption="@CommonVocabulary.Description"
                                      FieldName="@nameof(ClusterInfoModel.Description)" />

                    <DxGridDataColumn Caption="@TechnicalTerms.Version"
                                      FieldName="@nameof(ClusterInfoModel.Version)"
                                      Width="60" />

                    <DxGridDataColumn AllowGroup="false"
                                      FieldName="@nameof(ClusterInfoModel.Status)"
                                      TextAlignment="GridTextAlignment.Left"
                                      Width="15%" />

                    <DxGridDataColumn AllowGroup="false"
                                      FieldName="@nameof(ClusterInfoModel.DeploymentDuration)"
                                      TextAlignment="GridTextAlignment.Left"
                                      Width="15%" />

                    <DxGridCommandColumn Width="150px">
                        <HeaderTemplate>
                            Actions
                        </HeaderTemplate>
                        <CellDisplayTemplate>
                            <div class="action-column">
                                @if (context.DataItem is ClusterInfoModel model)
                                {
                                
                                    <Button IconCssClass="@_deployIconCssClass"
                                            CssClass="borderless"
                                            OnClick="@(async () => await DeployClusterVersion(model))"
                                            Enabled="@(!model.IsActive && Clusters.All(k => !k.IsExecuting))"
                                            Title="@CommonVocabulary.StartVerb"
                                            Size="@ButtonSize.Small" />

                                    <Button IconCssClass="@(model.IsLatest? _editIconCssClass : _infoIconCssClass)"
                                            CssClass="borderless"
                                            OnClick="@(() => HandleEdit(model))"
                                            Enabled="@(!model.IsExecuting && model.IsLatest)"
                                            Title="@CommonVocabulary.EditVerb"
                                            Size="@ButtonSize.Small" />

                                    <Button IconCssClass="@_downloadIconCssClass"
                                            CssClass="borderless"
                                            OnClick="@(() => DownloadClusterJson(model))"
                                            Enabled="@(!model.IsExecuting)"
                                            Title="@($"{CommonVocabulary.DownloadVerb} JSON")"
                                            Size="@ButtonSize.Small" />

                                    <Button IconCssClass="@_deleteIconCssClass"
                                            CssClass="borderless"
                                            OnClick="@(async () => await RemoveCluster(model))"
                                            Enabled="@(!model.IsExecuting && !model.IsActive && !model.IsDefault)"
                                            Title="@CommonVocabulary.Delete"
                                            Size="@ButtonSize.Small" />

                                }
                            </div>
                        </CellDisplayTemplate>
                    </DxGridCommandColumn>
                </Columns>
            </DxGrid>
        </div>
    }

    @if (!string.IsNullOrEmpty(_sagaState))
    {
        <div class="detail-container">
            <p>@_sagaState</p>
        </div>
    }
    else
    {
        <ClusterUpdateDisplay />
    }

</div>
