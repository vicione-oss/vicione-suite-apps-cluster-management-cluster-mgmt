@using ClusterManagement.Client.Management.Components;
@using ClusterManagement.Client.Management.Localization
@using ClusterManagement.Client.Management.Models
@using ClusterManagement.Public
@using Sdk.Authorization
@using ViciOne.Ui.Blazor.Components.Button
@using ViciOne.Ui.Blazor.Components.Button.Enums
@using ViciOne.Ui.Blazor.Components.Tables.Shared.Enums
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components
@using ViciOne.Ui.Blazor.Components.Tables.SimpleTable.Components.Columns
@using ViciOne.Ui.Blazor.Components.Toolbar.Components
@using ViciOne.Ui.Localization.Resources
@using ViciOne.Ui.MonochromeIcons.Core.Enums

@attribute [Route(Constants.ManagementModuleRoute)]
@attribute [ModuleAuthorize<ClusterManagementClientModule>(AccessLevel.Full)]

@inherits ModulePageBase<ClusterManagementClientModule>


<div class="cluster-mgmt">
    <div class="cluster-mgmt-toolbar">
        <Toolbar>
            <ToolbarGroup>
                <ToolbarContent Enabled="false" Tooltip="@SelectedCluster?.Key">
                    @(SelectedCluster != null ? SelectedCluster.DisplayNameVersion : string.Empty)
                </ToolbarContent>
            </ToolbarGroup>
            <ToolbarGroup AlignRight="true">
                <ToolbarButton Text="@(string.Format(UserActions.ResetSomething, "Saga"))"
                               OnClick="@ResetSagaStates"
                               IconName="@MonochromeIconName.Delete" />

                <ToolbarButton Text="@(string.Format(UserActions.GetSomething, "Saga"))"
                               OnClick="@GetSagaState"
                               IconName="@MonochromeIconName.Reload" />

                <ToolbarButton Text="@TechnicalTerms.EventPlural"
                               OnClick="@NavigateToEvents"
                               IconName="@MonochromeIconName.Properties" />
            </ToolbarGroup>
        </Toolbar>
    </div>

    @if (!_hasLoaded)
    {
        <LoadingSpinner Visible="true" />
    }
    else
    {
        <div class="cluster-mgmt-grid">
            <SimpleTable TItem="ClusterInfoModel"
                         Items="@Clusters"
                         SelectionMode="SelectionMode.Single"
                         RowClickSelectionEnabled="true"
                         SelectedItems="@_selectedClusters"
                         SelectedItemsChanged="@OnSelectedItemsChanged">
                <Columns>
                    <SimpleTableTemplateColumn Id="Name" Title="@CommonVocabulary.Name">
                        <CellContent>@context.DisplayName</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="Description" Title="@CommonVocabulary.Description">
                        <CellContent>@context.Description</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="Version" Title="@TechnicalTerms.Version" Width="100">
                        <CellContent>@context.Version</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="Status" Title="@CommonVocabulary.Status" Width="120">
                        <CellContent>@context.Status</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="Duration" Title="@Common.Duration" Width="120">
                        <CellContent>@context.DeploymentDuration</CellContent>
                    </SimpleTableTemplateColumn>
                    <SimpleTableTemplateColumn Id="Actions" Title="@CommonVocabulary.ActionPlural" Resizeable="false" Width="150">
                        <CellContent>
                            <div class="action-column">
                                <Button IconCssClass="@_deployIconCssClass"
                                        CssClass="borderless"
                                        OnClick="@(async () => await DeployClusterVersion(context))"
                                        Enabled="@(!context.IsActive && Clusters.All(k => !k.IsExecuting))"
                                        Title="@CommonVocabulary.StartVerb"
                                        Size="@ButtonSize.Small" />

                                <Button IconCssClass="@(context.IsLatest ? _editIconCssClass : _infoIconCssClass)"
                                        CssClass="borderless"
                                        OnClick="@(() => HandleEdit(context))"
                                        Enabled="@(!context.IsExecuting && context.IsLatest)"
                                        Title="@CommonVocabulary.EditVerb"
                                        Size="@ButtonSize.Small" />

                                <Button IconCssClass="@_downloadIconCssClass"
                                        CssClass="borderless"
                                        OnClick="@(() => DownloadClusterJson(context))"
                                        Enabled="@(!context.IsExecuting)"
                                        Title="@($"{CommonVocabulary.DownloadVerb} JSON")"
                                        Size="@ButtonSize.Small" />

                                <Button IconCssClass="@_deleteIconCssClass"
                                        CssClass="borderless"
                                        OnClick="@(async () => await RemoveCluster(context))"
                                        Enabled="@(!context.IsExecuting && !context.IsActive && !context.IsDefault)"
                                        Title="@CommonVocabulary.Delete"
                                        Size="@ButtonSize.Small" />
                            </div>
                        </CellContent>
                    </SimpleTableTemplateColumn>
                </Columns>
            </SimpleTable>
        </div>
    }

    @if (!string.IsNullOrEmpty(_sagaState))
    {
        <div class="detail-container">
            <p>@_sagaState</p>
        </div>
    }
    else
    {
        <ClusterUpdateDisplay />
    }

</div>
