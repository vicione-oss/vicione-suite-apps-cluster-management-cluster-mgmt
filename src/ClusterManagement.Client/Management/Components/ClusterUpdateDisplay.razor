@using ClusterManagement.Client.Resources

@if (UpdateStatus != null)
{
    <div class="update-process">
        @foreach (var node in UpdateStatus.Nodes)
        {
            <div class="@GetUpdateModelCss(node)" @key="node.Id">
                @((MarkupString)SvgIcons.server_network)

                @node.Name

                @if (node.CoreOS != null)
                {
                    <div class="@GetUpdateModelCss(node.CoreOS)" @key="node.CoreOS.Id">
                        CoreOS
                        @if (node.CoreOS.Error != null)
                        {
                            <span class="tooltiptext">@node.CoreOS.Error.Message</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
}
