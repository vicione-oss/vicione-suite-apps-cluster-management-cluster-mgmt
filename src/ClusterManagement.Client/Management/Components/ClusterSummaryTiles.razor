<section class="summary-tiles @(Expert ? null : "standard")">
    @foreach (var tile in Tiles)
    {
        <div class="tile" @key="tile.Label" title="@Tooltip(tile)">
            <div class="value @SizeClass(tile)">
                @Format(tile.Value)
                @if (tile.Of is { } of)
                {
                    <span class="of">/ @Format(of)</span>
                }
            </div>
            <div class="label">@tile.Text</div>
        </div>
    }
</section>
