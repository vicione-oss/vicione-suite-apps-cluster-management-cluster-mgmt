@using ClusterManagement.Public

@inherits ModulePageBase<ClusterManagementClientModule>
@attribute [Route(Constants.DebugEnginesRoute)]

@if (!_hasLoaded)
{
    <LoadingSpinner Visible="true" />
}
else
{
    <DxGrid AllowGroup="true"
            Data="@Engines"
            AutoExpandAllGroupRows="true"
            PagerVisible="true">
        <Columns>
            <DxGridDataColumn Caption="Engine-Host ID"
                                FieldName="@nameof(EngineInfoModel.EngineHostId)"
                                GroupIndex="0" />
            <DxGridDataColumn Caption="Engine-Host Name"
                                FieldName="@nameof(EngineInfoModel.EngineHostName)"/>
            <DxGridDataColumn Caption="Engine ID"
                                FieldName="@nameof(EngineInfoModel.EngineId)" />
            <DxGridDataColumn Caption="Engine Name"
                                FieldName="@nameof(EngineInfoModel.EngineName)" />
            <DxGridDataColumn Caption="Engine State"
                                FieldName="@nameof(EngineInfoModel.EngineState)" />
            <DxGridCommandColumn Width="150px">
                <HeaderTemplate>
                    Actions
                </HeaderTemplate>
                <CellDisplayTemplate>
                    @if (context.DataItem is EngineInfoModel model)
                    {
                        <button @onclick="@(async () => await StartEngine(model))"
                                class="btn"
                                type="button"
                                disabled="@(model.EngineState is not Internal.Requests.EngineState.Stopped)"
                                title="Start">
                            <span class="mdi mdi-motion-play-outline"></span>
                        </button>

                        <button @onclick="@(async () => await StopEngine(model))"
                                class="btn"
                                type="button"
                                disabled="@(model.EngineState is not Internal.Requests.EngineState.Running)"
                                title="Stop">
                            <span class="mdi mdi-motion-pause-outline"></span>
                        </button>

                        <button @onclick="@(async () => await TearDownEngine(model))"
                                class="btn"
                                type="button"
                                disabled="@(model.EngineState is not Internal.Requests.EngineState.Stopped)"
                                title="TearDown">
                            <span class="mdi mdi-trash-can-outline"></span>
                        </button>
                    }
                </CellDisplayTemplate>
            </DxGridCommandColumn>
        </Columns>
    </DxGrid>
}
