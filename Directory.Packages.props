<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ViciOneSuiteSdkVersion>3.0.0</ViciOneSuiteSdkVersion>
    <DotNetVersion>10.0.11</DotNetVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.102.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetVersion)" />
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
    <PackageVersion Include="Semver" Version="3.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.2.0" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="$(DotNetVersion)" />
    <PackageVersion Include="ViciOne.Cluster.Builder" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Core.Dataflow.DataModel.Generation" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Core.Runtime" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Core.Runtime.Analyzers" Version="0.4.0" />
    <PackageVersion Include="ViciOne.Suite.DataPort" Version="0.32.0" />
    <PackageVersion Include="ViciOne.Suite.Sdk" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Backend" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Deployment" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Client" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.System.DataPort" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Tree.Builder" Version="3.0.0" />
    <PackageVersion Include="ViciOne.Ui.ClusterEditor" Version="1.4.0-ci2814011212" />
    <PackageVersion Include="ViciOne.Ui.Design" Version="2.3.0" />
    <PackageVersion Include="ViciOne.Ui.Localization" Version="3.5.0" />
    <PackageVersion Include="ViciOne.Ui.MonochromeIcons.Components" Version="4.16.0" />
    <!--Used for tests only:-->
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Testing" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Ui.Blazor.Components.TestingHelpers" Version="5.19.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>
</Project>
