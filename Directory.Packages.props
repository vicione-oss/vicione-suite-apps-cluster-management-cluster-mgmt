<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ViciOneSuiteSdkVersion>2.0.1</ViciOneSuiteSdkVersion>
    <DotNetVersion>10.0.8</DotNetVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AspNetCore.SassCompiler" Version="1.99.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.8" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotNetVersion)" />
    <PackageVersion Include="MQTTnet" Version="5.1.0.1559" />
    <PackageVersion Include="Semver" Version="3.0.0" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.1.1" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="$(DotNetVersion)" />
    <PackageVersion Include="ViciOne.Cluster.Builder" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Core.Dataflow.DataModel.Generation" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Core.Runtime" Version="1.0.0" />
    <PackageVersion Include="ViciOne.Core.Runtime.Analyzers" Version="0.4.0" />
    <PackageVersion Include="ViciOne.Suite.DataPort" Version="0.30.0" />
    <PackageVersion Include="ViciOne.Suite.Sdk" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Backend" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Deployment" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Client" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Suite.System.DataPort" Version="1.0.0" />
    <PackageVersion Include="ViciOne.TreeBuilder" Version="1.1.1" />
    <PackageVersion Include="ViciOne.Ui.ClusterEditor" Version="1.0.0-ci2532983113" />
    <PackageVersion Include="ViciOne.Ui.Design" Version="2.0.3" />
    <PackageVersion Include="ViciOne.Ui.Localization" Version="3.3.0" />
    <PackageVersion Include="ViciOne.Ui.MonochromeIcons.Assets" Version="4.10.0" />
    <!--Used for tests only:-->
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.2.3" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.1.1" />
    <PackageVersion Include="ViciOne.Suite.Sdk.Testing" Version="$(ViciOneSuiteSdkVersion)" />
    <PackageVersion Include="ViciOne.Ui.Blazor.Components.TestingHelpers" Version="5.12.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.analyzers" Version="1.27.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
